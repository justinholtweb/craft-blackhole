{# The shell for every page the trap serves. No assets, no fonts, no requests — these pages are
   read by software far more often than by people, and the ones read by people are being read at
   a moment when the site has just refused them. #}
<!doctype html>
<html lang="{{ currentSite is defined and currentSite ? currentSite.language|split('-')|first : 'en' }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block pageTitle %}{% endblock %}</title>
    <style>
        :root { color-scheme: light dark; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0f1115;
            color: #e7e9ee;
            font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        main { max-width: 34rem; padding: 2.5rem 1.5rem; }
        h1 { font-size: 1.5rem; margin: 0 0 0.75rem; letter-spacing: -0.01em; }
        p { margin: 0 0 1rem; }
        .muted { color: #9aa1ad; font-size: 0.875rem; }
        code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.875rem; }
        .rule { height: 1px; background: #262a33; border: 0; margin: 1.5rem 0; }
    </style>
</head>
<body>
<main>
    {% block body %}{% endblock %}
</main>
</body>
</html>
