{% extends "blackhole/_site/_shell" %}

{% block pageTitle %}{{ "Nothing happened"|t('blackhole') }}{% endblock %}

{% block body %}
    <h1>{{ "Nothing happened"|t('blackhole') }}</h1>

    <p>
        {{ "This is the trap, and it did not close. Your address"|t('blackhole') }} <code>{{ ip }}</code>
        {{ "was let through."|t('blackhole') }}
    </p>

    {% if reason %}
        <p>{{ "Why:"|t('blackhole') }} <strong>{{ reason }}</strong>.</p>
    {% endif %}

    <hr class="rule">

    <p class="muted">
        {{ "You are seeing this rather than a blank page on purpose — “why didn’t it catch me?” is otherwise a genuinely hard question to answer from out here."|t('blackhole') }}
    </p>
{% endblock %}
